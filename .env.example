# ---------------------------------------------------------------------------
# Collection
# ---------------------------------------------------------------------------
# "auto" detects ~/.claude (or $CLAUDE_CONFIG_DIR). Inside Docker this must
# point at the read-only bind mount, e.g. /claude-data.
CLAUDE_DATA_PATH=auto
CCUSAGE_BIN=ccusage

# O Claude Code remove os proprios transcripts com o tempo. Sem uma copia,
# a cadeia metrica -> sessao -> evento -> bytes originais quebra e o dado
# bruto some. Ligado por padrao; custa ~120 MB por 50 sessoes.
ARCHIVE_TRANSCRIPTS=true
# TRANSCRIPT_ARCHIVE_PATH=/caminho/para/archive/transcripts

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://analytics:analytics@localhost:5432/ai_analytics

# Sessions touched within this window are treated as possibly still running
# and re-read on every sync.
ACTIVE_SESSION_THRESHOLD_MINUTES=30

# ---------------------------------------------------------------------------
# AI analysis (opt-in)
# Objective collection keeps working with this disabled.
# ---------------------------------------------------------------------------
AI_ANALYSIS_ENABLED=false
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=4096
# Redaction runs before any digest leaves the machine: home-directory
# prefix, e-mails, URL credentials and API-key-shaped strings.
LLM_REDACT_ENABLED=true
